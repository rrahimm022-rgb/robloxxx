generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  discordId String   @unique
  name      String
  email     String?
  image     String?
  tokens    Int      @default(25)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // dan model-model selanjutnya...
}
