# Required: generate a long random value, e.g. openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_URL="http://localhost:3000"

# Discord Developer Portal > OAuth2
AUTH_DISCORD_ID="your-discord-client-id"
AUTH_DISCORD_SECRET="your-discord-client-secret"
# Optional: comma-separated Discord user IDs allowed to manage token grants
ADMIN_DISCORD_IDS="your-discord-user-id"

# PostgreSQL database (Neon/Supabase/Vercel Postgres compatible)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/assetforge?sslmode=require"

# Roblox Open Cloud API key with Assets API permissions. Keep server-side only.
ROBLOX_API_KEY=""
# Your Roblox user ID or group ID; set the matching creator type below.
ROBLOX_CREATOR_ID=""
ROBLOX_CREATOR_TYPE="user"

# Optional OpenAI-compatible AI provider. Leave empty to disable AI features.
AI_API_URL="https://api.openai.com/v1/chat/completions"
AI_API_KEY=""
AI_MODEL="gpt-4o-mini"

# Limits
FREE_DAILY_AI_REQUESTS="10"
MAX_UPLOAD_MB="20"
